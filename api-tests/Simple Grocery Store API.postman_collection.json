    {
      "name": "Get all Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response returns a list of products\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Products contain required fields\", function () {",
              "    const firstProduct = pm.response.json()[0];",
              "    if (firstProduct) {",
              "        pm.expect(firstProduct).to.have.all.keys('id', 'category', 'name', 'inStock');",
              "    }",
              "});",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
